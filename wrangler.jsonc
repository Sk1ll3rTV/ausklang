{
  // Ein Worker für alles: statische PWA aus ./dist plus optionaler KI-Proxy unter /api/coach.
  // Deployment: `npm run deploy` oder Cloudflare Workers Builds (GitHub → main).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ausklang",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Nur API-Aufrufe laufen durch den Worker-Code, alles andere kommt direkt aus den Assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
